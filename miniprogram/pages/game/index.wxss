/* pages/game/index.wxss · 主游戏页 v7.2 */

.page {
  min-height: 100vh;
  padding: 16rpx 24rpx 24rpx;
  background-color: #FFE9B8;
}

/* ============ 顶部导航 ============ */
.topbar {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
  height: 88rpx;
}

.back-btn {
  background: #FFFCF2;
  border: 4rpx solid #2C2C2A;
  border-radius: 16rpx;
  box-shadow: 3rpx 3rpx 0 0 #2C2C2A;
  padding: 12rpx 20rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: #2C2C2A;
  flex-shrink: 0;
}

.back-btn:active {
  transform: translate(2rpx, 2rpx);
  box-shadow: 1rpx 1rpx 0 0 #2C2C2A;
}

.topbar-title {
  flex: 1;
  text-align: center;
  padding: 0 12rpx;
}

.level-name {
  font-size: 36rpx;
  font-weight: 800;
  color: #2C2C2A;
  line-height: 1.1;
}

.chapter-tag {
  display: inline-block;
  background: #2C2C2A;
  color: #FFE9B8;
  font-size: 20rpx;
  font-weight: 600;
  padding: 3rpx 14rpx;
  border-radius: 16rpx;
  margin-top: 4rpx;
}

.hint-btn {
  width: 80rpx;
  height: 80rpx;
  background: #FFFCF2;
  border: 4rpx solid #2C2C2A;
  border-radius: 50%;
  box-shadow: 3rpx 3rpx 0 0 #2C2C2A;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.hint-btn.--locked {
  opacity: 0.6;
}

.hint-icon {
  font-size: 36rpx;
  line-height: 1;
}

.hint-timer {
  font-size: 16rpx;
  font-weight: 700;
  color: #5F5E5A;
  line-height: 1;
  margin-top: 2rpx;
}

/* ============ 地图 Canvas ============ */
.map-wrap {
  background: #FFFCF2;
  border: 5rpx solid #2C2C2A;
  border-radius: 24rpx;
  box-shadow: 4rpx 4rpx 0 0 #2C2C2A;
  padding: 8rpx;
  margin-bottom: 16rpx;
  /* 高度由 JS 根据 grid 比例计算后用 inline style 设置 */
}

.game-canvas {
  width: 100%;
  height: 100%;
  display: block;
}

/* ============ 对话气泡 ============ */
.dialog-card {
  background: #FFFCF2;
  border: 5rpx solid #85B7EB; /* 对话用蓝色描边强调 */
  border-radius: 20rpx;
  box-shadow: 4rpx 4rpx 0 0 #2C2C2A;
  padding: 16rpx;
  margin-bottom: 16rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.dialog-avatar {
  width: 80rpx;
  height: 80rpx;
  background: #FFF1C9;
  border: 3rpx solid #2C2C2A;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  flex-shrink: 0;
}

.dialog-content {
  flex: 1;
  min-width: 0;
}

.dialog-speaker {
  font-size: 22rpx;
  font-weight: 800;
  color: #2C2C2A;
  margin-bottom: 4rpx;
}

.dialog-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #2C2C2A;
  line-height: 1.3;
}

.dialog-next {
  background: #FF6B47;
  border: 3rpx solid #2C2C2A;
  border-radius: 20rpx;
  color: #FFFFFF;
  font-size: 24rpx;
  font-weight: 800;
  padding: 12rpx 18rpx;
  flex-shrink: 0;
}

.dialog-next:active {
  transform: translate(2rpx, 2rpx);
}

/* ============ 提示卡 ============ */
.hint-card {
  background: #FFF1C9;
  border: 4rpx solid #FF6B47;
  border-radius: 16rpx;
  padding: 16rpx;
  margin-bottom: 16rpx;
}

.hint-card-title {
  font-size: 24rpx;
  font-weight: 800;
  color: #FF6B47;
  margin-bottom: 6rpx;
}

.hint-card-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #2C2C2A;
  line-height: 1.4;
  margin-bottom: 10rpx;
}

.hint-more {
  display: inline-block;
  font-size: 22rpx;
  font-weight: 700;
  color: #FF6B47;
  margin-right: 16rpx;
}

.hint-close {
  display: inline-block;
  font-size: 22rpx;
  font-weight: 700;
  color: #5F5E5A;
}

/* ============ 指令栏 ============ */
.cmd-section {
  margin-bottom: 16rpx;
}

.cmd-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 10rpx;
}

.cmd-title {
  font-size: 32rpx;
  font-weight: 800;
  color: #2C2C2A;
}

.cmd-tip {
  font-size: 22rpx;
  font-weight: 600;
  color: #5F5E5A;
}

.cmd-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.cmd-card {
  width: 162rpx;
  height: 130rpx;
  background: #FFF1C9;
  border: 4rpx solid #2C2C2A;
  border-radius: 18rpx;
  box-shadow: 4rpx 4rpx 0 0 #2C2C2A;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.cmd-card:active {
  transform: translate(2rpx, 2rpx);
  box-shadow: 2rpx 2rpx 0 0 #2C2C2A;
}

.cmd-icon {
  font-size: 50rpx;
  font-weight: 800;
  color: #2C2C2A;
  line-height: 1;
  margin-bottom: 4rpx;
}

.cmd-label {
  font-size: 24rpx;
  font-weight: 700;
  color: #2C2C2A;
}

/* ============ 队列 ============ */
.queue-section {
  margin-bottom: 16rpx;
}

.queue-row {
  display: flex;
  align-items: baseline;
  margin-bottom: 8rpx;
  gap: 16rpx;
}

.queue-title {
  font-size: 30rpx;
  font-weight: 800;
  color: #2C2C2A;
}

.queue-count {
  font-size: 22rpx;
  font-weight: 600;
  color: #5F5E5A;
  flex: 1;
}

.queue-clear {
  font-size: 24rpx;
  font-weight: 800;
  color: #FF6B47;
}

.queue-clear.--disabled {
  color: #888780;
}

.queue-scroll {
  background: #FFFCF2;
  border: 3rpx solid #2C2C2A;
  border-radius: 16rpx;
  padding: 10rpx;
  white-space: nowrap;
}

.queue-list {
  display: inline-flex;
  gap: 10rpx;
}

.queue-item {
  background: #FFF1C9;
  border: 3rpx solid #2C2C2A;
  border-radius: 12rpx;
  padding: 10rpx 16rpx;
  flex-shrink: 0;
}

.queue-item-text {
  font-size: 24rpx;
  font-weight: 700;
  color: #2C2C2A;
  white-space: nowrap;
}

.queue-empty {
  background: #FFFCF2;
  border: 3rpx dashed #888780;
  border-radius: 16rpx;
  padding: 22rpx;
  text-align: center;
  font-size: 24rpx;
  font-weight: 600;
  color: #888780;
}

/* ============ 操作区 ============ */
.action-row {
  display: flex;
  gap: 16rpx;
  margin-top: 8rpx;
}

.reset-btn {
  width: 100rpx;
  height: 100rpx;
  background: #FFFCF2;
  border: 4rpx solid #2C2C2A;
  border-radius: 24rpx;
  box-shadow: 4rpx 4rpx 0 0 #2C2C2A;
  font-size: 50rpx;
  font-weight: 800;
  color: #2C2C2A;
  text-align: center;
  line-height: 100rpx;
  flex-shrink: 0;
}

.reset-btn:active {
  transform: translate(2rpx, 2rpx);
  box-shadow: 2rpx 2rpx 0 0 #2C2C2A;
}

.exec-btn {
  flex: 1;
  background: #FF6B47;
  border: 4rpx solid #2C2C2A;
  border-radius: 50rpx;
  box-shadow: 4rpx 4rpx 0 0 #2C2C2A;
  font-size: 40rpx;
  font-weight: 900;
  color: #FFFFFF;
  text-align: center;
  line-height: 92rpx;
  height: 100rpx;
}

.exec-btn:active {
  transform: translate(2rpx, 2rpx);
  box-shadow: 2rpx 2rpx 0 0 #2C2C2A;
}

.exec-btn.--disabled {
  opacity: 0.5;
}

/* ============ 通关弹窗 ============ */
.cleared-overlay,
.failed-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(44, 44, 42, 0.6);
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
}

.cleared-scroll {
  width: 100%;
  max-height: 100vh;
  padding: 60rpx 32rpx 80rpx;
  box-sizing: border-box;
}

.cleared-card {
  background: #FFFCF2;
  border: 5rpx solid #2C2C2A;
  border-radius: 28rpx;
  box-shadow: 6rpx 6rpx 0 0 #2C2C2A;
  padding: 36rpx 28rpx 32rpx;
  text-align: center;
  width: 100%;
  max-width: 600rpx;
  margin: 0 auto;
  animation: cleared-pop-in 0.4s ease-out 0.4s backwards;
}

@keyframes cleared-pop-in {
  0%   { transform: translateY(40rpx) scale(0.92); opacity: 0; }
  60%  { transform: translateY(-8rpx) scale(1.02); opacity: 1; }
  100% { transform: translateY(0) scale(1); opacity: 1; }
}

.cleared-trophy {
  font-size: 96rpx;
  margin-bottom: 4rpx;
  line-height: 1;
}

.cleared-title {
  font-size: 56rpx;
  font-weight: 900;
  color: #FF6B47;
  margin-bottom: 4rpx;
  line-height: 1.2;
}

.cleared-meta {
  font-size: 24rpx;
  font-weight: 600;
  color: #5F5E5A;
  margin-bottom: 22rpx;
}

.cleared-dialog {
  background: #FFF1C9;
  border: 3rpx solid #2C2C2A;
  border-radius: 16rpx;
  padding: 16rpx;
  margin-bottom: 22rpx;
  text-align: left;
}

.cleared-speaker {
  font-size: 22rpx;
  font-weight: 800;
  color: #2C2C2A;
  margin-bottom: 4rpx;
}

.cleared-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #2C2C2A;
  line-height: 1.3;
}

.cleared-actions {
  display: flex;
  justify-content: center;
}

.cleared-btn-primary {
  background: #FF6B47;
  border: 4rpx solid #2C2C2A;
  border-radius: 40rpx;
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 800;
  padding: 18rpx 40rpx;
  box-shadow: 4rpx 4rpx 0 0 #2C2C2A;
}

.cleared-btn-primary:active {
  transform: translate(2rpx, 2rpx);
  box-shadow: 2rpx 2rpx 0 0 #2C2C2A;
}

.cleared-btn-secondary {
  background: #FFF1C9;
  border: 4rpx solid #2C2C2A;
  border-radius: 40rpx;
  color: #2C2C2A;
  font-size: 28rpx;
  font-weight: 800;
  padding: 18rpx 36rpx;
  box-shadow: 4rpx 4rpx 0 0 #2C2C2A;
}

.cleared-btn-secondary:active {
  transform: translate(2rpx, 2rpx);
  box-shadow: 2rpx 2rpx 0 0 #2C2C2A;
}

/* ============ 通关瞬间庆祝特效 ============ */
.celebration-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 150;
  display: flex;
  align-items: center;
  justify-content: center;
  pointer-events: none;
}

/* 中心朱砂橙圆形扩散波 */
.celebration-burst {
  position: absolute;
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  background: #FF6B47;
  opacity: 0.5;
  animation: burst-expand 0.8s ease-out forwards;
}

@keyframes burst-expand {
  0%   { width: 100rpx; height: 100rpx; opacity: 0.7; }
  100% { width: 1200rpx; height: 1200rpx; opacity: 0; }
}

/* 大奖杯放大跳跃 */
.celebration-trophy {
  font-size: 200rpx;
  line-height: 1;
  animation: trophy-bounce 0.8s ease-out forwards;
}

@keyframes trophy-bounce {
  0%   { transform: scale(0) rotate(-30deg); opacity: 0; }
  40%  { transform: scale(1.3) rotate(8deg); opacity: 1; }
  60%  { transform: scale(1.1) rotate(-4deg); opacity: 1; }
  80%  { transform: scale(1.15) rotate(2deg); opacity: 1; }
  100% { transform: scale(1.1) rotate(0); opacity: 0; }
}

/* "过关!" 文字 */
.celebration-text {
  position: absolute;
  bottom: 40%;
  font-size: 100rpx;
  font-weight: 900;
  color: #FF6B47;
  text-shadow: 4rpx 4rpx 0 #2C2C2A, -2rpx -2rpx 0 #2C2C2A, 4rpx -2rpx 0 #2C2C2A, -2rpx 4rpx 0 #2C2C2A;
  letter-spacing: 8rpx;
  animation: text-pop 0.8s ease-out 0.15s backwards;
}

@keyframes text-pop {
  0%   { transform: scale(0); opacity: 0; }
  50%  { transform: scale(1.2); opacity: 1; }
  85%  { transform: scale(1); opacity: 1; }
  100% { transform: scale(1.1); opacity: 0; }
}

/* 6 个朱砂橙小火花,放射状 */
.celebration-spark {
  position: absolute;
  width: 24rpx;
  height: 24rpx;
  background: #FF6B47;
  border: 3rpx solid #2C2C2A;
  border-radius: 50%;
  opacity: 0;
}

.spark-1 { animation: spark-fly-1 0.7s ease-out 0.1s forwards; }
.spark-2 { animation: spark-fly-2 0.7s ease-out 0.1s forwards; }
.spark-3 { animation: spark-fly-3 0.7s ease-out 0.1s forwards; }
.spark-4 { animation: spark-fly-4 0.7s ease-out 0.1s forwards; }
.spark-5 { animation: spark-fly-5 0.7s ease-out 0.1s forwards; }
.spark-6 { animation: spark-fly-6 0.7s ease-out 0.1s forwards; }

@keyframes spark-fly-1 { 0%{transform:translate(0,0) scale(0);opacity:0} 30%{opacity:1} 100%{transform:translate(-260rpx,-180rpx) scale(0.4);opacity:0} }
@keyframes spark-fly-2 { 0%{transform:translate(0,0) scale(0);opacity:0} 30%{opacity:1} 100%{transform:translate(260rpx,-180rpx) scale(0.4);opacity:0} }
@keyframes spark-fly-3 { 0%{transform:translate(0,0) scale(0);opacity:0} 30%{opacity:1} 100%{transform:translate(-300rpx,40rpx) scale(0.4);opacity:0} }
@keyframes spark-fly-4 { 0%{transform:translate(0,0) scale(0);opacity:0} 30%{opacity:1} 100%{transform:translate(300rpx,40rpx) scale(0.4);opacity:0} }
@keyframes spark-fly-5 { 0%{transform:translate(0,0) scale(0);opacity:0} 30%{opacity:1} 100%{transform:translate(-180rpx,220rpx) scale(0.4);opacity:0} }
@keyframes spark-fly-6 { 0%{transform:translate(0,0) scale(0);opacity:0} 30%{opacity:1} 100%{transform:translate(180rpx,220rpx) scale(0.4);opacity:0} }

/* ============ 失败弹窗 ============ */
.failed-card {
  background: #FFFCF2;
  border: 5rpx solid #FF6B47;
  border-radius: 24rpx;
  box-shadow: 6rpx 6rpx 0 0 #2C2C2A;
  padding: 36rpx 28rpx;
  text-align: center;
  width: 100%;
  max-width: 560rpx;
}

.failed-text {
  font-size: 32rpx;
  font-weight: 700;
  color: #2C2C2A;
  margin-bottom: 24rpx;
  line-height: 1.4;
}

.failed-btn {
  background: #FF6B47;
  border: 4rpx solid #2C2C2A;
  border-radius: 40rpx;
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 800;
  padding: 16rpx 36rpx;
  display: inline-block;
  box-shadow: 4rpx 4rpx 0 0 #2C2C2A;
}

.failed-actions {
  display: flex;
  gap: 16rpx;
  justify-content: center;
}

.failed-btn-primary {
  background: #FF6B47;
  border: 4rpx solid #2C2C2A;
  border-radius: 40rpx;
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 800;
  padding: 16rpx 28rpx;
  box-shadow: 4rpx 4rpx 0 0 #2C2C2A;
}

.failed-btn-primary:active {
  transform: translate(2rpx, 2rpx);
  box-shadow: 2rpx 2rpx 0 0 #2C2C2A;
}

.failed-btn-secondary {
  background: #FFF1C9;
  border: 4rpx solid #2C2C2A;
  border-radius: 40rpx;
  color: #2C2C2A;
  font-size: 28rpx;
  font-weight: 800;
  padding: 16rpx 28rpx;
  box-shadow: 4rpx 4rpx 0 0 #2C2C2A;
}

.failed-btn-secondary:active {
  transform: translate(2rpx, 2rpx);
  box-shadow: 2rpx 2rpx 0 0 #2C2C2A;
}

/* ============ 步数选择面板(底部抽屉式)============ */
.picker-overlay {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(44, 44, 42, 0.4);
  z-index: 200;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.picker-card {
  background: #FFFCF2;
  border-top: 5rpx solid #2C2C2A;
  border-radius: 28rpx 28rpx 0 0;
  padding: 20rpx 24rpx 32rpx;
  width: 100%;
  max-width: 750rpx;
  box-shadow: 0 -4rpx 0 0 #2C2C2A;
}

.picker-title {
  font-size: 28rpx;
  font-weight: 800;
  color: #2C2C2A;
  text-align: center;
  margin-bottom: 16rpx;
}

.picker-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.picker-cell {
  background: #FFF1C9;
  border: 4rpx solid #2C2C2A;
  border-radius: 14rpx;
  box-shadow: 3rpx 3rpx 0 0 #2C2C2A;
  font-size: 36rpx;
  font-weight: 900;
  color: #2C2C2A;
  text-align: center;
  padding: 14rpx 0;
}

.picker-cell:active {
  transform: translate(2rpx, 2rpx);
  box-shadow: 1rpx 1rpx 0 0 #2C2C2A;
}

.picker-cancel {
  text-align: center;
  font-size: 26rpx;
  font-weight: 700;
  color: #5F5E5A;
  padding: 12rpx 0 0;
}
