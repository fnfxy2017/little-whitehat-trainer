/* pages/levels/index.wxss · 选关页样式(无 CSS 变量版) */

.page {
  min-height: 100vh;
  padding: 80rpx 40rpx 60rpx;
  background-color: #FFE9B8;
}

.title {
  font-size: 56rpx;
  font-weight: 800;
  text-align: center;
  color: #2C2C2A;
  margin-bottom: 12rpx;
}

.subtitle {
  font-size: 28rpx;
  font-weight: 600;
  text-align: center;
  color: #5F5E5A;
  margin-bottom: 60rpx;
}

.error-banner {
  background: #FF6B47;
  color: #FFFFFF;
  padding: 24rpx;
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: 700;
  margin-bottom: 32rpx;
  word-break: break-all;
}

.status-card {
  background: #FFF1C9;
  border: 5rpx solid #2C2C2A;
  border-radius: 32rpx;
  box-shadow: 4rpx 4rpx 0 0 #2C2C2A;
  padding: 40rpx 32rpx;
  margin-bottom: 40rpx;
}

.status-text {
  font-size: 36rpx;
  font-weight: 800;
  color: #FF6B47;
  margin-bottom: 24rpx;
}

.status-meta {
  font-size: 30rpx;
  font-weight: 600;
  color: #5F5E5A;
  margin-bottom: 8rpx;
}

.list-card {
  background: #FFF1C9;
  border: 5rpx solid #2C2C2A;
  border-radius: 24rpx;
  box-shadow: 4rpx 4rpx 0 0 #2C2C2A;
  padding: 32rpx;
  margin-bottom: 60rpx;
}

.list-title {
  font-size: 32rpx;
  font-weight: 800;
  color: #2C2C2A;
  margin-bottom: 16rpx;
}

.list-item {
  font-size: 28rpx;
  font-weight: 600;
  color: #5F5E5A;
  padding: 8rpx 0;
}

.test-output {
  margin-top: 32rpx;
  padding: 24rpx;
  background: #FFFCF2;
  border: 4rpx solid #2C2C2A;
  border-radius: 16rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #5F5E5A;
  white-space: pre-wrap;
  word-break: break-all;
}
