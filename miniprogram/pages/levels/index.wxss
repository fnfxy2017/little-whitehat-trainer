/* pages/levels/index.wxss · 选关页 v7.2 真实样式(优化版) */

.page {
  min-height: 100vh;
  padding: 24rpx 32rpx 240rpx;  /* 底部 240rpx 留够 tab-bar + 安全区空间 */
  background-color: #FFE9B8;
}

/* ============ 顶部标题 ============ */
.header {
  text-align: center;
  margin-bottom: 28rpx;
}

.title {
  font-size: 60rpx;
  font-weight: 800;
  color: #2C2C2A;
  margin-bottom: 8rpx;
  line-height: 1.2;
}

.subtitle {
  font-size: 26rpx;
  font-weight: 600;
  color: #5F5E5A;
}

/* ============ 总进度卡 ============ */
.progress-card {
  background: #FFFCF2;
  border: 5rpx solid #2C2C2A;
  border-radius: 24rpx;
  box-shadow: 4rpx 4rpx 0 0 #2C2C2A;
  padding: 22rpx 28rpx;
  margin-bottom: 36rpx;
}

.progress-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.progress-label {
  font-size: 28rpx;
  font-weight: 700;
  color: #2C2C2A;
  flex-shrink: 0;
}

.progress-bar-bg {
  flex: 1;
  height: 24rpx;
  background: #FFE9B8;
  border-radius: 12rpx;
  border: 3rpx solid #2C2C2A;
  overflow: hidden;
}

.progress-bar-fill {
  height: 100%;
  background: #FF6B47;
  border-radius: 9rpx;
  transition: width 0.3s ease-out;
}

.progress-count {
  font-size: 28rpx;
  font-weight: 800;
  flex-shrink: 0;
  /* 默认灰色,有进度时通过 .--has-progress 才变橙 */
  color: #5F5E5A;
}

.progress-count.--has-progress {
  color: #FF6B47;
}

/* ============ 错误条 ============ */
.error-banner {
  background: #FF6B47;
  color: #FFFFFF;
  padding: 20rpx 24rpx;
  border-radius: 16rpx;
  font-size: 26rpx;
  font-weight: 700;
  margin-bottom: 32rpx;
  word-break: break-all;
}

/* ============ 幕区段 ============ */
.act-section {
  margin-bottom: 36rpx;
}

.act-header {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 18rpx;
  padding: 0 4rpx;
}

.act-title {
  font-size: 34rpx;
  font-weight: 800;
  color: #2C2C2A;
}

.act-meta {
  font-size: 24rpx;
  font-weight: 700;
}

.act-meta.--unlocked {
  color: #FF6B47;
}

.act-meta.--locked {
  color: #888780;
}

/* ============ 关卡卡片网格 · 一行 4 个 ============ */
.level-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.level-card {
  /* 一行 4 个,左右总 686rpx,gap 14*3=42rpx,单卡 (686-42)/4=161rpx */
  width: 161rpx;
  height: 220rpx;
  background: #FFF1C9;
  border: 4rpx solid #2C2C2A;
  border-radius: 20rpx;
  box-shadow: 4rpx 4rpx 0 0 #2C2C2A;
  padding: 16rpx 8rpx 12rpx;
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
}

.level-card.--locked {
  border-style: dashed;
  background: #FFFCF2;
}

.level-card.--playing {
  background: #2C2C2A;
}

.level-card:active {
  transform: translate(2rpx, 2rpx);
  box-shadow: 2rpx 2rpx 0 0 #2C2C2A;
}

.level-id {
  font-size: 38rpx;
  font-weight: 900;
  color: #2C2C2A;
  margin-bottom: 8rpx;
  line-height: 1;
}

.level-title {
  font-size: 20rpx;
  font-weight: 700;
  color: #2C2C2A;
  text-align: center;
  margin-bottom: 6rpx;
  line-height: 1.25;
  /* 让长标题最多 2 行,溢出截断 */
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  word-break: break-all;
}

.level-tag {
  font-size: 18rpx;
  font-weight: 600;
  color: #5F5E5A;
  text-align: center;
  line-height: 1.2;
  /* 标签贴底,跟标题之间留弹性空间 */
  margin-top: auto;
}

/* 锁定卡 */
.level-card.--locked .level-id,
.level-card.--locked .level-title,
.level-card.--locked .level-tag {
  color: #888780;
}

/* 在玩中卡(墨黑底反白) */
.level-card.--playing .level-id,
.level-card.--playing .level-title,
.level-card.--playing .level-tag {
  color: #FFE9B8;
}

/* 状态徽章 · 右上角(在玩中) */
.badge {
  position: absolute;
  top: -12rpx;
  right: -12rpx;
  width: 50rpx;
  height: 50rpx;
  border-radius: 50%;
  background: #FF6B47;
  border: 4rpx solid #2C2C2A;
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 900;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}

/* "在玩" 状态用文字标签代替 ! 徽章,更直观 */
.playing-flag {
  position: absolute;
  top: -10rpx;
  right: -8rpx;
  background: #FF6B47;
  color: #FFFFFF;
  font-size: 18rpx;
  font-weight: 800;
  padding: 4rpx 10rpx;
  border-radius: 14rpx;
  border: 3rpx solid #2C2C2A;
  letter-spacing: 1rpx;
}

.badge-lock {
  position: absolute;
  top: 6rpx;
  right: 6rpx;
  font-size: 22rpx;
  filter: grayscale(0.4);
  opacity: 0.7;
}

/* ============ 锁定的幕(整张大占位卡)============ */
.act-locked-card {
  background: #FFFCF2;
  border: 5rpx dashed #2C2C2A;
  border-radius: 24rpx;
  padding: 36rpx 28rpx;
  text-align: center;
}

.act-locked-icon {
  font-size: 48rpx;
  margin-bottom: 14rpx;
  opacity: 0.6;
  filter: grayscale(0.5);
}

.act-locked-text {
  font-size: 26rpx;
  font-weight: 700;
  color: #5F5E5A;
  margin-bottom: 6rpx;
}

.act-locked-meta {
  font-size: 22rpx;
  font-weight: 600;
  color: #888780;
  font-style: italic;
}

/* ============ 调试区 ============ */
.debug-section {
  margin-top: 60rpx;
  padding-top: 24rpx;
  border-top: 2rpx dashed #888780;
}

.debug-btn {
  background: #FFFCF2;
  border: 3rpx solid #888780;
  border-radius: 16rpx;
  padding: 16rpx;
  text-align: center;
  font-size: 24rpx;
  font-weight: 600;
  color: #5F5E5A;
}

.test-output {
  margin-top: 16rpx;
  padding: 16rpx;
  background: #FFFCF2;
  border: 3rpx solid #2C2C2A;
  border-radius: 12rpx;
  font-size: 22rpx;
  font-weight: 600;
  color: #5F5E5A;
  white-space: pre-wrap;
  word-break: break-all;
}

/* ============ 底部 tab 栏 ============ */
.tab-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  height: 110rpx;
  background: #FFFCF2;
  border-top: 4rpx solid #2C2C2A;
  display: flex;
  align-items: center;
  justify-content: space-around;
  padding: 0 32rpx;
  padding-bottom: env(safe-area-inset-bottom);
}

.tab {
  flex: 1;
  text-align: center;
  padding: 12rpx;
}

.tab-label {
  font-size: 26rpx;
  font-weight: 700;
  color: #888780;
}

.tab-active {
  background: #FF6B47;
  border: 3rpx solid #2C2C2A;
  border-radius: 60rpx;
  padding: 14rpx 32rpx;
  flex: 0 0 auto;
}

.tab-active .tab-label {
  color: #FFFFFF;
  font-weight: 800;
}
