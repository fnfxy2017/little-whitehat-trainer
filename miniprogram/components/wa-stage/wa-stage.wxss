/* components/wa-stage/wa-stage.wxss · DOM 舞台 · v7.2 严格 5 色 */

.stage {
  position: relative;
  background: #2C2C2A;
  border: 5rpx solid #2C2C2A;
  border-radius: 20rpx;
  box-shadow: 6rpx 6rpx 0 0 #2C2C2A;
  overflow: hidden;
  box-sizing: border-box;
}

/* ============ 1. 地板格 ============ */
.cell {
  position: absolute;
  box-sizing: border-box;
}
.cell--floor {
  background: #FFF1C9;
  border: 1rpx solid rgba(44, 44, 42, 0.15);
  border-radius: 4rpx;
  margin: 2rpx;
  width: calc(100% - 4rpx);
}

/* ============ 2. 墙 ============ */
.wall {
  position: absolute;
  background: #2C2C2A;
  display: flex;
  flex-direction: column;
  justify-content: space-evenly;
  padding: 4rpx 0;
  box-sizing: border-box;
}
.wall-stripe {
  height: 1rpx;
  background: #FFE9B8;
  opacity: 0.25;
  margin: 0 4rpx;
}

/* ============ 3. 装饰物 ============ */
.decorative {
  position: absolute;
  box-sizing: border-box;
  border-radius: 14rpx;
}
.decorative--rug {
  background: #FF6B47;
  opacity: 0.28;
  border: 2rpx dashed #FF6B47;
}

/* ============ 4. 家具 ============ */
.furniture {
  position: absolute;
  box-sizing: border-box;
  background: #FFFCF2;
  border: 4rpx solid #2C2C2A;
  border-radius: 12rpx;
  box-shadow: 3rpx 3rpx 0 0 #2C2C2A;
  display: flex;
  align-items: center;
  justify-content: center;
}
.furniture-icon {
  font-size: 38rpx;
  font-weight: 800;
}

.furniture--bed { background: #FFFFFF; }
.furniture--desk { background: #FFFCF2; }
.furniture--lamp,
.furniture--plant,
.furniture--stove,
.furniture--table { background: #FFFCF2; }
.furniture--window { background: #D9F0FF; }
.furniture--tv { background: #FFFFFF; }

/* ============ 5. 目标 ============ */
.goal {
  position: absolute;
  box-sizing: border-box;
  border-radius: 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  z-index: 5;
}
.goal--door {
  background: #FF6B47;
  border: 4rpx solid #2C2C2A;
  box-shadow: 3rpx 3rpx 0 0 #2C2C2A;
}
.goal--zone {
  border: 4rpx dashed #FF6B47;
  background: rgba(255, 107, 71, 0.18);
}
.goal--cred-door {
  background: #5F5E5A;       /* 锁定状态:深灰像金属门 */
  border: 4rpx solid #2C2C2A;
  box-shadow: 3rpx 3rpx 0 0 #2C2C2A;
}
.goal--cred-door.goal--unlocked {
  background: #FF6B47;       /* 解锁后变朱砂橙 + 闪烁 */
  animation: goal-unlock-flash 600ms ease-out;
}
@keyframes goal-unlock-flash {
  0%   { background: #5F5E5A; }
  40%  { background: #F1C40F; transform: scale(1.06); }
  100% { background: #FF6B47; transform: scale(1); }
}

.goal-icon {
  font-size: 32rpx;
  color: #FFFFFF;
  line-height: 1;
}
.goal--zone .goal-icon { color: #FF6B47; font-size: 28rpx; }
.goal--unlocked .goal-icon { color: #FFFFFF; font-size: 38rpx; font-weight: 900; }

.goal-tag {
  font-size: 16rpx;
  font-weight: 800;
  color: #FFE9B8;
  background: rgba(0, 0, 0, 0.4);
  padding: 1rpx 6rpx;
  border-radius: 6rpx;
  margin-top: 3rpx;
}
.goal-tag--ok {
  color: #FFFFFF;
  background: rgba(0, 0, 0, 0.5);
}
.goal-exit-arrow {
  position: absolute;
  bottom: -22rpx;
  font-size: 16rpx;
  font-weight: 900;
  color: #FF6B47;
  background: #FFFCF2;
  padding: 1rpx 6rpx;
  border: 2rpx solid #2C2C2A;
  border-radius: 4rpx;
  white-space: nowrap;
}

/* ============ 6. NPC · 用 npc-sprite 渲染,这里只放定位 ============ */
.npc-wrap {
  position: absolute;
  z-index: 6;
}

/* ============ 7c. 货架(C1) ============ */
.shelf {
  position: absolute;
  z-index: 6;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #FFFCF2;
  border: 4rpx solid #2C2C2A;
  border-radius: 10rpx;
  box-shadow: 3rpx 3rpx 0 0 #2C2C2A;
  margin: 4rpx;
  width: calc(100% - 8rpx);
  height: calc(100% - 8rpx);
  box-sizing: border-box;
}
.shelf--trap {
  border-color: #FF6B47;
  border-style: dashed;
  background: #FFE9B8;
}
.shelf--purchased {
  background: #FFE9B8;
  opacity: 0.55;
}
.shelf-badge {
  position: absolute;
  top: -8rpx;
  right: -6rpx;
  background: #2ECC71;
  color: #FFFFFF;
  font-size: 22rpx;
  font-weight: 900;
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  border: 3rpx solid #2C2C2A;
  display: flex;
  align-items: center;
  justify-content: center;
}
.shelf-emoji {
  font-size: 40rpx;
  line-height: 1;
}
.shelf-label {
  font-size: 16rpx;
  font-weight: 800;
  color: #2C2C2A;
  margin-top: 2rpx;
  letter-spacing: 1rpx;
}

/* ============ 7d. 花朵(T5) ============ */
.flower {
  position: absolute;
  z-index: 7;
  pointer-events: none;
}

/* 花盆(底部) */
.flower-pot {
  position: absolute;
  bottom: 6%;
  left: 30%;
  width: 40%;
  height: 22%;
  background: #B85A3C;
  border: 3rpx solid #2C2C2A;
  border-radius: 0 0 6rpx 6rpx;
  clip-path: polygon(10% 0, 90% 0, 100% 100%, 0 100%);
  -webkit-clip-path: polygon(10% 0, 90% 0, 100% 100%, 0 100%);
  box-sizing: border-box;
}

/* 茎 */
.flower-stem {
  position: absolute;
  bottom: 24%;
  left: 50%;
  transform: translateX(-50%);
  width: 5rpx;
  height: 28%;
  background: #5C8E3E;
}

/* 花朵主体 */
.flower-bloom {
  position: absolute;
  top: 18%;
  left: 22%;
  width: 56%;
  height: 42%;
}

.petal {
  position: absolute;
  width: 38%;
  height: 38%;
  border: 3rpx solid #2C2C2A;
  border-radius: 50%;
  box-sizing: border-box;
}
.petal--top    { top: 0;    left: 31%;     background: #FF8FB8; }
.petal--right  { top: 31%;  right: 0;      background: #FF8FB8; }
.petal--bottom { bottom: 0; left: 31%;     background: #FF8FB8; }
.petal--left   { top: 31%;  left: 0;       background: #FF8FB8; }

.flower-center {
  position: absolute;
  top: 30%; left: 30%;
  width: 40%; height: 40%;
  background: #F5C724;
  border: 3rpx solid #2C2C2A;
  border-radius: 50%;
  box-sizing: border-box;
  z-index: 2;
}

/* 干花:灰色枯萎,花瓣下垂 */
.flower--dry .petal--top    { background: #C8A990; transform: scale(0.85) translateY(8%); }
.flower--dry .petal--right  { background: #C8A990; transform: scale(0.85) translateX(-8%); }
.flower--dry .petal--bottom { background: #C8A990; transform: scale(0.85); }
.flower--dry .petal--left   { background: #C8A990; transform: scale(0.85) translateX(8%); }
.flower--dry .flower-center { background: #B89A6F; }
.flower--dry .flower-stem   { background: #8B7960; }

/* 浇水后:鲜艳粉花 + 摆动 + 顶上一片小绿叶 */
.flower--watered .flower-bloom {
  animation: flower-bloom-grow 500ms ease-out;
}
@keyframes flower-bloom-grow {
  0%   { transform: scale(0.8); }
  60%  { transform: scale(1.15); }
  100% { transform: scale(1); }
}

.flower-leaf {
  position: absolute;
  bottom: 30%;
  right: 22%;
  width: 16%;
  height: 12%;
  background: #5C8E3E;
  border: 2rpx solid #2C2C2A;
  border-radius: 50% 50% 50% 0;
  transform: rotate(30deg);
  box-sizing: border-box;
}

/* ============ 7d. 浇水水滴动画 ============ */
.watering-effect {
  position: absolute;
  pointer-events: none;
  z-index: 8;
}
.water-drop {
  position: absolute;
  font-size: 30rpx;
  top: -8rpx;
  left: 50%;
  opacity: 0;
}
.drop-1 { animation: drop-fall 350ms ease-in 0ms forwards; transform: translateX(-50%); }
.drop-2 { animation: drop-fall 350ms ease-in 80ms forwards; transform: translateX(-110%); }
.drop-3 { animation: drop-fall 350ms ease-in 160ms forwards; transform: translateX(10%); }

@keyframes drop-fall {
  0%   { top: -8rpx; opacity: 0; }
  20%  { opacity: 1; }
  100% { top: 50%; opacity: 0.3; }
}

/* ============ 7. 物品(地上) ============ */
.item-on-ground {
  position: absolute;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 7;
}
.item-icon {
  font-size: 40rpx;
  background: #FFFFFF;
  border: 3rpx solid #2C2C2A;
  border-radius: 12rpx;
  width: 60rpx;
  height: 60rpx;
  line-height: 54rpx;
  text-align: center;
  box-shadow: 2rpx 2rpx 0 0 #2C2C2A;
}

/* ============ 红苹果(C2 / X1 等)============ */
.apple-shape {
  position: relative;
  width: 70%;
  height: 70%;
  animation: cred-card-pulse 1.6s ease-in-out infinite;
}
.apple-body {
  position: absolute;
  bottom: 0;
  left: 4%;
  width: 92%;
  height: 80%;
  background: #E73C2E;
  border: 3rpx solid #2C2C2A;
  border-radius: 50% 50% 48% 48% / 60% 60% 40% 40%;
  box-sizing: border-box;
}
.apple-body::after {
  content: '';
  position: absolute;
  top: -2rpx;
  left: 38%;
  width: 24%;
  height: 8rpx;
  background: #B82A1F;
  border-radius: 50%;
  opacity: 0.5;
}
.apple-stem {
  position: absolute;
  top: -2rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 5rpx;
  height: 24%;
  background: #5D3A1A;
  border-radius: 2rpx;
  z-index: 2;
}
.apple-leaf {
  position: absolute;
  top: 8%;
  left: 56%;
  width: 26%;
  height: 18%;
  background: #5C8E3E;
  border: 2rpx solid #2C2C2A;
  border-radius: 50% 50% 50% 0;
  transform: rotate(35deg);
  box-sizing: border-box;
  z-index: 1;
}
.apple-shine {
  position: absolute;
  top: 28%;
  left: 14%;
  width: 16%;
  height: 22%;
  background: #FFFFFF;
  border-radius: 50%;
  opacity: 0.7;
  z-index: 1;
}

/* mini 版(婉婉手持)—— 缩小 + 不带浮动动画 */
.apple-shape--mini {
  width: 100%;
  height: 100%;
  animation: none;
}
.apple-shape--mini .apple-body { border-width: 2rpx; }
.apple-shape--mini .apple-stem { width: 3rpx; }
.apple-shape--mini .apple-leaf { border-width: 1rpx; }
.apple-shape--mini .apple-shine { opacity: 0.55; }

/* 凭证道具:贴纸卡片造型 */
.cred-card {
  width: 90%;
  height: 70%;
  background: #FFFFFF;
  border: 3rpx solid #2C2C2A;
  border-radius: 8rpx;
  box-shadow: 3rpx 3rpx 0 0 #FF6B47, 5rpx 5rpx 0 0 #2C2C2A;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 4rpx;
  box-sizing: border-box;
  position: relative;
  animation: cred-card-pulse 1.6s ease-in-out infinite;
}
/* 卡片左侧那条朱砂橙杠(像 ID 卡的分割线) */
.cred-card::before {
  content: '';
  position: absolute;
  left: 4rpx;
  top: 8rpx;
  bottom: 8rpx;
  width: 6rpx;
  background: #FF6B47;
  border-radius: 3rpx;
}
.cred-card-emoji {
  font-size: 26rpx;
  line-height: 1;
}
.cred-card-label {
  font-size: 14rpx;
  font-weight: 800;
  color: #2C2C2A;
  margin-top: 2rpx;
  letter-spacing: 1rpx;
}

/* 微微浮动,提示这是可交互道具 */
@keyframes cred-card-pulse {
  0%, 100% { transform: translateY(0) rotate(-2deg); }
  50%      { transform: translateY(-3rpx) rotate(2deg); }
}

/* ============ 7b. 取证件飞行动画 ============ */
.taking-item {
  position: absolute;
  z-index: 12;
  display: flex;
  align-items: center;
  justify-content: center;
  pointer-events: none;
  animation: taking-flight 600ms cubic-bezier(0.4, 0, 0.2, 1) forwards;
}
@keyframes taking-flight {
  0% {
    transform: translate(0, 0) scale(1) rotate(0deg);
    opacity: 1;
  }
  60% {
    transform: translate(calc(var(--tx) * 0.7), calc(var(--ty) * 0.7 - 60rpx)) scale(1.4) rotate(360deg);
    opacity: 1;
  }
  100% {
    transform: translate(var(--tx), var(--ty)) scale(0.5) rotate(720deg);
    opacity: 0.4;
  }
}
.taking-card {
  width: 80%;
  height: 60%;
  background: #FFFFFF;
  border: 3rpx solid #2C2C2A;
  border-radius: 8rpx;
  box-shadow: 0 6rpx 12rpx rgba(255, 107, 71, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
}
.taking-emoji {
  font-size: 36rpx;
}

/* ============ 8. 婉婉 ============ */
.wanwan {
  position: absolute;
  z-index: 10;
  /* transform 由 inline style 控制 */
}
.wanwan-body {
  position: relative;
  width: 70%;
  height: 88%;
  margin: 6% auto;
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* 帽子 */
.wanwan-cap {
  width: 84%;
  height: 28%;
  background: #FFFFFF;
  border: 3rpx solid #2C2C2A;
  border-radius: 50% 50% 30% 30%;
  position: relative;
}
.wanwan-cap::after {
  /* 帽舌 */
  content: '';
  position: absolute;
  right: -28%;
  top: 60%;
  width: 38%;
  height: 30%;
  background: #FFFFFF;
  border: 3rpx solid #2C2C2A;
  border-radius: 0 50% 50% 0;
}
.wanwan-cap-heart {
  position: absolute;
  top: 4%;
  left: 50%;
  transform: translateX(-50%);
  color: #FF6B9D;
  font-size: 26rpx;
  font-weight: 900;
  z-index: 2;
}

/* 脸 */
.wanwan-face {
  width: 76%;
  height: 32%;
  background: #FDE3C3;
  border: 3rpx solid #2C2C2A;
  border-radius: 50%;
  position: relative;
  margin-top: -8%;
}
.eye {
  position: absolute;
  top: 32%;
  width: 14%;
  height: 26%;
  background: #2C2C2A;
  border-radius: 50%;
}
.eye--l { left: 22%; }
.eye--r { right: 22%; }
.mouth {
  position: absolute;
  bottom: 22%;
  left: 35%;
  width: 30%;
  height: 18%;
  border: 3rpx solid #2C2C2A;
  border-top: none;
  border-radius: 0 0 100% 100%;
}

/* 衣服 */
.wanwan-shirt {
  width: 80%;
  height: 22%;
  background: #FFFFFF;
  border: 3rpx solid #2C2C2A;
  border-radius: 14rpx 14rpx 4rpx 4rpx;
  margin-top: 0;
}
.wanwan-pants {
  width: 70%;
  height: 18%;
  background: #3498DB;
  border: 3rpx solid #2C2C2A;
  border-top: none;
  border-radius: 0 0 10rpx 10rpx;
}

/* 手持物品 */
.held-item {
  position: absolute;
  top: -8%;
  right: -10%;
  width: 38%;
  height: 38%;
  background: #FFFFFF;
  border: 3rpx solid #2C2C2A;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  z-index: 11;
}

/* ============ 婉婉庆祝姿势 ============ */
.wanwan--celebrate .wanwan-body {
  animation: wanwan-jump 600ms ease-out;
}
@keyframes wanwan-jump {
  0%   { transform: translateY(0); }
  50%  { transform: translateY(-18rpx); }
  100% { transform: translateY(0); }
}

/* ============ 9. 信号灯 ============ */
.traffic-light {
  position: absolute;
  background: #3D3D3D;
  border: 3rpx solid #2C2C2A;
  border-radius: 8rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: space-around;
  padding: 4rpx 0;
  z-index: 5;
  margin: 8rpx;
  width: 60%;
  height: 84%;
}
.light {
  width: 30%;
  aspect-ratio: 1;
  border-radius: 50%;
  background: #5C5C5C;
  border: 2rpx solid #2C2C2A;
}
.light--lit.light--red { background: #E74C3C; }
.light--lit.light--yellow { background: #F1C40F; }
.light--lit.light--green { background: #27AE60; }

/* ============ 10. 庆祝特效 ============ */
.celebrate-overlay {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  pointer-events: none;
  z-index: 50;
  display: flex;
  align-items: center;
  justify-content: center;
}
.celebrate-burst {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: #FF6B47;
  opacity: 0.5;
  animation: burst 800ms ease-out forwards;
}
@keyframes burst {
  0% { transform: scale(0.3); opacity: 0.7; }
  100% { transform: scale(8); opacity: 0; }
}

.petal {
  position: absolute;
  font-size: 36rpx;
  color: #FF6B47;
  opacity: 0;
}
.petal-1 { animation: petal1 700ms ease-out forwards; }
.petal-2 { animation: petal2 700ms ease-out forwards; }
.petal-3 { animation: petal3 700ms ease-out forwards; }
.petal-4 { animation: petal4 700ms ease-out forwards; }
.petal-5 { animation: petal5 700ms ease-out forwards; }
.petal-6 { animation: petal6 700ms ease-out forwards; }
@keyframes petal1 { 0%{transform:translate(0,0) scale(0);opacity:0} 30%{opacity:1} 100%{transform:translate(-160rpx,-120rpx) scale(0.4) rotate(120deg);opacity:0} }
@keyframes petal2 { 0%{transform:translate(0,0) scale(0);opacity:0} 30%{opacity:1} 100%{transform:translate(160rpx,-120rpx) scale(0.4) rotate(-120deg);opacity:0} }
@keyframes petal3 { 0%{transform:translate(0,0) scale(0);opacity:0} 30%{opacity:1} 100%{transform:translate(-200rpx,40rpx) scale(0.4) rotate(80deg);opacity:0} }
@keyframes petal4 { 0%{transform:translate(0,0) scale(0);opacity:0} 30%{opacity:1} 100%{transform:translate(200rpx,40rpx) scale(0.4) rotate(-80deg);opacity:0} }
@keyframes petal5 { 0%{transform:translate(0,0) scale(0);opacity:0} 30%{opacity:1} 100%{transform:translate(-100rpx,160rpx) scale(0.4) rotate(40deg);opacity:0} }
@keyframes petal6 { 0%{transform:translate(0,0) scale(0);opacity:0} 30%{opacity:1} 100%{transform:translate(100rpx,160rpx) scale(0.4) rotate(-40deg);opacity:0} }
