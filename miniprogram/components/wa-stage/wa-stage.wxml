<!-- wa-stage.wxml · 婉婉舞台 · 方案 A:纯 DOM + transform -->
<view class="stage" style="width: {{stageW}}px; height: {{stageH}}px;">

  <!-- 1. 地板格(可走) -->
  <view
    wx:for="{{walkables}}"
    wx:for-item="cell"
    wx:key="key"
    class="cell cell--floor"
    style="left: {{cell.x * cellSize}}px; top: {{cell.y * cellSize}}px; width: {{cellSize}}px; height: {{cellSize}}px;"
  ></view>

  <!-- 2. 墙(黑色砖块) -->
  <view
    wx:for="{{walls}}"
    wx:for-item="w"
    wx:key="key"
    class="wall"
    style="left: {{w.x * cellSize}}px; top: {{w.y * cellSize}}px; width: {{w.w * cellSize}}px; height: {{w.h * cellSize}}px;"
  >
    <view class="wall-stripe" wx:for="{{w.stripeCount}}" wx:for-item="_s" wx:key="*this"></view>
  </view>

  <!-- 3. 装饰物(地毯) -->
  <view
    wx:for="{{decoratives}}"
    wx:for-item="d"
    wx:key="key"
    class="decorative decorative--{{d.type}}"
    style="left: {{d.x * cellSize}}px; top: {{d.y * cellSize}}px; width: {{d.w * cellSize}}px; height: {{d.h * cellSize}}px;"
  ></view>

  <!-- 4. 家具 -->
  <view
    wx:for="{{furniture}}"
    wx:for-item="f"
    wx:key="key"
    class="furniture furniture--{{f.type}}"
    style="left: {{f.x * cellSize}}px; top: {{f.y * cellSize}}px; width: {{f.w * cellSize}}px; height: {{f.h * cellSize}}px;"
  >
    <text class="furniture-icon">{{f.icon}}</text>
  </view>

  <!-- 5. 目标(门 / 目标区 / 凭证门) -->
  <view
    wx:if="{{goal}}"
    class="goal goal--{{goal.kind}} {{goal.unlocked ? 'goal--unlocked' : ''}}"
    style="left: {{goal.x * cellSize}}px; top: {{goal.y * cellSize}}px; width: {{cellSize}}px; height: {{cellSize}}px;"
  >
    <text class="goal-icon">{{goal.unlocked ? '✓' : goal.icon}}</text>
    <text wx:if="{{goal.kind === 'cred-door' && !goal.unlocked}}" class="goal-tag">需凭证</text>
    <text wx:if="{{goal.kind === 'cred-door' && goal.unlocked}}" class="goal-tag goal-tag--ok">已解锁</text>
    <text wx:if="{{goal.kind === 'door' || goal.kind === 'cred-door'}}" class="goal-exit-arrow">出口</text>
  </view>

  <!-- 6. NPCs · 标准困困造型 + 布莱克(例外) -->
  <view
    wx:for="{{npcs}}"
    wx:for-item="n"
    wx:key="id"
    class="npc-wrap {{n.isGuard ? 'npc-wrap--guard' : ''}} {{n.asided ? 'npc-wrap--asided' : ''}}"
    style="left: {{n.x * cellSize}}px; top: {{n.y * cellSize}}px; width: {{cellSize}}px; height: {{cellSize}}px;"
  >
    <blake-sprite wx:if="{{n.type === 'blake'}}" size="{{cellSize}}" />
    <npc-sprite
      wx:else
      size="{{cellSize}}"
      mainColor="{{n.profile.mainColor}}"
      accentColor="{{n.profile.accentColor}}"
      decoration="{{n.profile.decoration}}"
      mood="{{n.profile.mood}}"
      showBlush="{{n.profile.showBlush}}"
    />
    <view wx:if="{{n.isGuard && !n.asided}}" class="guard-badge">🛡</view>
  </view>

  <!-- 6b. 守卫拦截气泡(C4) -->
  <view
    wx:if="{{guardBubble}}"
    class="guard-bubble"
    style="left: {{guardBubble.x * cellSize}}px; top: {{guardBubble.y * cellSize}}px;"
  >
    <view class="guard-bubble-text">{{guardBubble.text}}</view>
    <view class="guard-bubble-tail"></view>
  </view>

  <!-- 7. 物品(地上)— 凭证特殊样式 -->
  <view
    wx:for="{{groundItems}}"
    wx:for-item="it"
    wx:key="id"
    class="item-on-ground item--{{it.type}} item--{{it.sprite}}"
    style="left: {{it.x * cellSize}}px; top: {{it.y * cellSize}}px; width: {{cellSize}}px; height: {{cellSize}}px;"
  >
    <!-- 红苹果(C2 等):红色圆球 + 棕色叶柄 + 高光 -->
    <view wx:if="{{it.sprite === 'red_apple'}}" class="apple-shape">
      <view class="apple-body"></view>
      <view class="apple-stem"></view>
      <view class="apple-leaf"></view>
      <view class="apple-shine"></view>
    </view>

    <!-- 凭证卡(T4 借书卡):白色 ID 卡 -->
    <view wx:elif="{{it.type === 'credential' && it.sprite === 'card'}}" class="cred-card">
      <text class="cred-card-emoji">🪪</text>
      <text class="cred-card-label">{{it.credentialType === 'library_card' ? '借书卡' : '凭证'}}</text>
    </view>

    <!-- 通用 credential:白卡兜底 -->
    <view wx:elif="{{it.type === 'credential'}}" class="cred-card">
      <text class="cred-card-emoji">🪪</text>
      <text class="cred-card-label">凭证</text>
    </view>

    <!-- 普通物品 -->
    <text wx:else class="item-icon">{{it.icon}}</text>
  </view>

  <!-- 7b. 取证件飞行动画(独立渲染层) -->
  <view
    wx:if="{{takingItem}}"
    class="taking-item"
    style="left: {{takingItem.fromX * cellSize}}px; top: {{takingItem.fromY * cellSize}}px;
           width: {{cellSize}}px; height: {{cellSize}}px;
           --tx: {{(takingItem.toX - takingItem.fromX) * cellSize}}px;
           --ty: {{(takingItem.toY - takingItem.fromY) * cellSize}}px;"
  >
    <view wx:if="{{takingItem.sprite === 'red_apple'}}" class="taking-card taking-card--apple">
      <view class="apple-shape">
        <view class="apple-body"></view>
        <view class="apple-stem"></view>
        <view class="apple-leaf"></view>
        <view class="apple-shine"></view>
      </view>
    </view>
    <view wx:else class="taking-card">
      <text class="taking-emoji">{{takingItem.icon}}</text>
    </view>
  </view>

  <!-- 7c. 货架(C1)/ 场景物件(含 C3 镜子) -->
  <view
    wx:for="{{shelves}}"
    wx:for-item="sh"
    wx:key="id"
    class="shelf {{sh.trap ? 'shelf--trap' : ''}} {{sh.purchased ? 'shelf--purchased' : ''}} {{sh.watching ? 'shelf--watching' : ''}} {{sh.broken ? 'shelf--broken' : ''}}"
    style="left: {{sh.x * cellSize}}px; top: {{sh.y * cellSize}}px; width: {{cellSize}}px; height: {{cellSize}}px;"
  >
    <text class="shelf-emoji">{{sh.broken ? '💢' : sh.emoji}}</text>
    <text class="shelf-label">{{sh.broken ? '碎了' : sh.label}}</text>
    <view wx:if="{{sh.purchased}}" class="shelf-badge">✓</view>
    <view wx:if="{{sh.watching}}" class="shelf-watch-eye">👁</view>
  </view>

  <!-- 7d. 花朵(T5)— 未浇水/已浇水两态 -->
  <view
    wx:for="{{flowers}}"
    wx:for-item="fl"
    wx:key="id"
    class="flower {{fl.watered ? 'flower--watered' : 'flower--dry'}}"
    style="left: {{fl.x * cellSize}}px; top: {{fl.y * cellSize}}px; width: {{cellSize}}px; height: {{cellSize}}px;"
  >
    <view class="flower-pot"></view>
    <view class="flower-stem"></view>
    <view class="flower-bloom">
      <view class="petal petal--top"></view>
      <view class="petal petal--right"></view>
      <view class="petal petal--bottom"></view>
      <view class="petal petal--left"></view>
      <view class="flower-center"></view>
    </view>
    <view wx:if="{{fl.watered}}" class="flower-leaf"></view>
  </view>

  <!-- 7d. 浇水水滴动画 -->
  <view
    wx:if="{{wateringEffect}}"
    class="watering-effect"
    style="left: {{wateringEffect.x * cellSize}}px; top: {{wateringEffect.y * cellSize}}px; width: {{cellSize}}px; height: {{cellSize}}px;"
  >
    <view class="water-drop drop-1">💧</view>
    <view class="water-drop drop-2">💧</view>
    <view class="water-drop drop-3">💧</view>
  </view>

  <!-- 8. 婉婉 -->
  <view
    class="wanwan {{celebrating ? 'wanwan--celebrate' : ''}}"
    style="width: {{cellSize}}px; height: {{cellSize}}px; transform: translate({{playerX * cellSize}}px, {{playerY * cellSize}}px); transition: transform {{stepDuration}}ms ease-out;"
  >
    <view class="wanwan-body">
      <view class="wanwan-cap"></view>
      <view class="wanwan-cap-heart">♥</view>
      <view class="wanwan-face">
        <view class="eye eye--l"></view>
        <view class="eye eye--r"></view>
        <view class="mouth"></view>
      </view>
      <view class="wanwan-shirt"></view>
      <view class="wanwan-pants"></view>
      <!-- 手持物品 -->
      <view wx:if="{{heldItemIcon}}" class="held-item held-item--{{heldItemSprite || 'generic'}}">
        <view wx:if="{{heldItemSprite === 'red_apple'}}" class="apple-shape apple-shape--mini">
          <view class="apple-body"></view>
          <view class="apple-stem"></view>
          <view class="apple-leaf"></view>
        </view>
        <text wx:else>{{heldItemIcon}}</text>
      </view>
    </view>
  </view>

  <!-- 9. 信号灯(可染色) -->
  <view
    wx:for="{{colorables}}"
    wx:for-item="cl"
    wx:key="id"
    class="traffic-light"
    style="left: {{cl.x * cellSize}}px; top: {{cl.y * cellSize}}px; width: {{cellSize}}px; height: {{cellSize}}px;"
  >
    <view class="light light--red {{cl.litRed ? 'light--lit' : ''}}"></view>
    <view class="light light--yellow {{cl.litYellow ? 'light--lit' : ''}}"></view>
    <view class="light light--green {{cl.litGreen ? 'light--lit' : ''}}"></view>
  </view>

  <!-- 10. 通关庆祝粒子(纯 CSS 动画) -->
  <view wx:if="{{celebrating}}" class="celebrate-overlay">
    <view class="celebrate-burst"></view>
    <view class="petal petal-1">✦</view>
    <view class="petal petal-2">✦</view>
    <view class="petal petal-3">✦</view>
    <view class="petal petal-4">✦</view>
    <view class="petal petal-5">✦</view>
    <view class="petal petal-6">✦</view>
  </view>
</view>
