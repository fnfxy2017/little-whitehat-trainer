<!-- npc-sprite.wxml · 标准 NPC 造型(SKILL _STYLE_GUIDE 规则) -->
<view class="sprite sprite--{{mood}}" style="width: {{size}}px; height: {{size}}px;">

  <!-- 头顶抖动小线 -->
  <view class="wobble wobble-1" style="background: {{accentColor || mainColor}};"></view>
  <view class="wobble wobble-2" style="background: {{accentColor || mainColor}};"></view>
  <view class="wobble wobble-3" style="background: {{accentColor || mainColor}};"></view>

  <!-- 头顶装饰 -->
  <view class="deco deco--{{decoration}}" style="--main: {{mainColor}}; --accent: {{accentColor || mainColor}};"></view>

  <!-- 头(大圆) -->
  <view class="head" style="background: {{mainColor}}; --main: {{mainColor}}; --accent: {{accentColor || mainColor}};">
    <view class="eye eye--l">
      <view class="eyelid"></view>
      <view class="pupil"></view>
      <view class="hl"></view>
    </view>
    <view class="eye eye--r">
      <view class="eyelid"></view>
      <view class="pupil"></view>
      <view class="hl"></view>
    </view>
    <view class="mouth mouth--{{mood || 'chill'}}"></view>
    <view wx:if="{{showBlush}}" class="blush blush--l"></view>
    <view wx:if="{{showBlush}}" class="blush blush--r"></view>
  </view>

  <!-- 身体(梯形) -->
  <view class="body" style="background: {{bodyColor || mainColor}};"></view>
</view>
