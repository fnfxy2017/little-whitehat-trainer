/* app.wxss - 全局样式 · v7.2 设计系统(无 CSS 变量版,确保兼容性)
   严格 3 色:米黄系 4 档 + 墨黑 + 朱砂橙 */

/* page 全局背景 + 字体 */
page {
  background-color: #FFE9B8;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC",
               "HarmonyOS Sans SC", "Microsoft YaHei", sans-serif;
  color: #2C2C2A;
}

/* 通用 · 卡片(玩具立体感) */
.card {
  background: #FFF1C9;
  border: 5rpx solid #2C2C2A;
  border-radius: 24rpx;
  box-shadow: 4rpx 4rpx 0 0 #2C2C2A;
}

.card.--pale {
  background: #FFFCF2;
}

.card.--ink {
  background: #2C2C2A;
  color: #FFE9B8;
}

.card:active {
  transform: translate(2rpx, 2rpx);
  box-shadow: 2rpx 2rpx 0 0 #2C2C2A;
}

/* 通用 · 主行动按钮 */
.action-btn {
  background: #FF6B47;
  border: 6rpx solid #2C2C2A;
  border-radius: 110rpx;
  box-shadow: 4rpx 4rpx 0 0 #2C2C2A;
  color: #FFFFFF;
  font-size: 64rpx;
  font-weight: 800;
  text-align: center;
  padding: 30rpx 0;
  margin-top: 20rpx;
}

.action-btn:active {
  transform: translate(2rpx, 2rpx);
  box-shadow: 2rpx 2rpx 0 0 #2C2C2A;
}

view, text {
  box-sizing: border-box;
}

.--hidden {
  display: none;
}
